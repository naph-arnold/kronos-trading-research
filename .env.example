# Research / DEMO-only example. Never add real broker/API secrets here or to Git.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
# Required by trading.config.load_demo_environment; the only accepted value is "demo".
EXECUTION_MODE=demo
# Only the Binance Spot Testnet host is accepted.
BINANCE_TESTNET_BASE_URL=https://testnet.binance.vision
# BINANCE_TESTNET_API_KEY=testnet-only-key-in-untracked-.env
# BINANCE_TESTNET_API_SECRET=testnet-only-secret-in-untracked-.env
# Variables such as BINANCE_API_KEY / MT5_REAL_PASSWORD make the process refuse to start.
# XAI_API_KEY=xai-key-for-the-six-grok-agents-in-untracked-.env (advisory only; cannot approve orders)
# DATA_PROVIDER_API_KEY=put-your-key-in-a-local-untracked-.env-file
